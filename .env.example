# ========================================================
# NIVESH SURAKSHA (निवेश सुरक्षा) - Environment Config
# SANGYAN Hackathon (IIT BHU with SEBI & NSDL)
# ========================================================

# Server Port (default 5000)
PORT=5000

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# LLM Provider Configuration
# Options: 'gemini' | 'claude' | 'openai' | 'local'
# If keys are left empty, the application automatically uses
# the robust zero-config local reasoning engine (Local Reasoner).
LLM_PROVIDER=local

# Google Gemini API Key (optional)
GEMINI_API_KEY=

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=
